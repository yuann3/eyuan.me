---
import Wordmark from './Wordmark.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<header class="panel-header" data-reveal>
	<div class="panel-topbar">
		<Wordmark class="wordmark-sm" />
		<a href="/" class="label-mono close" aria-keyshortcuts="Escape">CLOSE <span class="close-x" aria-hidden="true">×</span></a>
	</div>
	<div class="panel-heading">
		<h1 class="panel-title">{title}</h1>
		<div class="panel-actions">
			<slot name="actions" />
			<a href="/" class="label-mono close close-desktop" aria-keyshortcuts="Escape">CLOSE <span class="close-x" aria-hidden="true">×</span></a>
		</div>
	</div>
</header>
