---
interface Props {
	prevUrl?: string;
	nextUrl?: string;
}

const { prevUrl, nextUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="label-mono flex pt-6 text-ink-2">
			{prevUrl && <a href={prevUrl}>← Prev</a>}
			{nextUrl && <a href={nextUrl} class="ms-auto">Next →</a>}
		</nav>
	)
}
