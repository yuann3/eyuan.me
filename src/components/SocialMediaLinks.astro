---
import { socialLinks } from "../consts.ts";
---

<div class="flex flex-wrap items-center gap-1">
	{
		socialLinks.map(({ link, friendlyName}, index) => (
			<>
				{index > 0 && <span class="text-muted">/</span>}
				<a
					class="px-1 hover:bg-black hover:text-bgColor text-sm"
					href={link}
					target="_blank"
					rel="noopener noreferrer"
					title={friendlyName}
				>
					{friendlyName}
				</a>
			</>
		))
	}
</div>
