---
import FormattedDate from "@/components/FormattedDate";

interface Props {
	href: string;
	title: string;
	description?: string;
	date?: Date;
	meta?: string;
}

const { href, title, description, date, meta } = Astro.props;
const lane = "shrink-0 font-mono text-[12px] leading-[18px] text-muted md:w-[140px] md:text-[13px]";
---

<li class="border-t border-hairline" data-reveal>
	<a href={href} class="row-link list-row flex flex-col gap-1.5 py-5 md:flex-row md:items-baseline md:gap-0 md:py-8">
		{date ? <FormattedDate date={date} class={lane} /> : <span class={lane}>{meta}</span>}
		<span class="flex min-w-0 flex-1 flex-col gap-1 md:gap-2 md:pr-10">
			<span class="self-start text-[20px] font-medium leading-[26px] tracking-[-0.02em] text-ink md:text-[28px] md:leading-[34px]" data-row-name>{title}</span>
			{description && <span class="text-[14px] leading-5 text-ink-2 md:text-[15px] md:leading-[22px]">{description}</span>}
		</span>
		<span class="row-arrow list-row-arrow" data-row-arrow aria-hidden="true">→</span>
	</a>
</li>

<style>
	.list-row {
		position: relative;
	}

	/* Trailing arrow on the row's right edge, out of the flow. */
	.list-row-arrow {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		color: var(--ink-2);
		font-size: 18px;
	}
</style>
