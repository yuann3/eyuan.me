---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"blog">;
	withDesc?: boolean;
};

const { post, withDesc = false } = Astro.props;
const postDate = post.data.updatedDate ?? post.data.pubDate;
const pinned: boolean = !!post.data.order;
---

<li class="flex items-baseline gap-2">
	<span class="text-muted">></span>
	<FormattedDate date={postDate} class="text-muted text-xs font-mono tabular-nums"/>
	<a href={`/blog/${post.slug}/`} class="cody-link" data-astro-prefetch>
		{post.data.title}
	</a>
	{pinned && <span class="text-xs border border-black px-1">pinned</span>}
	{withDesc && <span class="text-muted text-xs">- {post.data.description}</span>}
</li>

