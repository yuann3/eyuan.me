---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"blog" | "project">;
	withDesc?: boolean;
};

const { post, withDesc = false } = Astro.props;
const postDate = post.data.updatedDate ?? post.data.pubDate;
const pinned: boolean = !!post.data.order;
const urlBasePath = post.collection === "project" ? "projects" : post.collection;
---

<li class="border-b border-dotted border-black pb-2">
	<div class="flex items-baseline gap-2">
		<span class="text-muted">></span>
		<a href={`/${urlBasePath}/${post.slug}/`} class="cody-link font-bold">
			{post.data.title}
		</a>
		{pinned && <span class="text-xs border border-black px-1">pinned</span>}
	</div>
	<div class="flex items-center gap-2 mt-1 ml-4">
		<FormattedDate date={postDate} class="text-muted text-xs"/>
		{withDesc && <span class="text-muted text-xs">/ {post.data.description}</span>}
	</div>
</li>
