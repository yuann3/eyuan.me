---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro';
import { siteConfig } from "../consts.ts";

interface Props {
		title?: string;
		description?: string;
		image?: string;
		articleDate?: string;
}

const { title = "", description = siteConfig.description, image, articleDate } = Astro.props;

---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} articleDate={articleDate} />
	</head>
	<body>
		<Header/>
		<main>
			<slot/>
		</main>
		<Footer/>
	</body>
</html>
