---
import Shell from '@/layouts/Shell';
import PanelHeader from '@/components/PanelHeader';
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { title, description, pubDate, heroImage, stack, website, github } = project.data;
const links = [
	{ title: 'GITHUB', href: github },
	{ title: 'WEBSITE', href: website !== github ? website : undefined },
].filter((link) => link.href);
---

<Shell title={title} description={description} articleDate={pubDate.toISOString()} section="projects">
	<PanelHeader title={title.toLowerCase()} />
	<p class="label-mono flex flex-wrap gap-x-6 gap-y-2 text-muted">
		<span>{[...stack, pubDate.getFullYear()].join(' · ')}</span>
		{links.map((link) => (
			<a href={link.href} target="_blank" rel="noopener" class="text-ink-2">{link.title} ↗</a>
		))}
	</p>
	<article class="prose-panel project-body mt-10">
		{heroImage && <img src={heroImage.url} alt={heroImage.alt ?? ''} />}
		<slot />
	</article>
</Shell>

<style>
	/* Most write-ups repeat the title as their first heading. */
	.project-body > :global(h1:first-of-type) {
		display: none;
	}
</style>
