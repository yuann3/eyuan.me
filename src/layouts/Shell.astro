---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Wordmark from '../components/Wordmark.astro';
import { siteConfig, SECTIONS, FOOTER_LINKS, type Section } from '../consts';
import { FILM_STATES, palette, gradientCss, type FilmLayout, type Scheme } from '../scripts/film-palettes';

interface Props {
	title: string;
	description?: string;
	section?: Section;
	image?: string;
	articleDate?: string;
}

const { title, description = siteConfig.description, section, image, articleDate } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Static film (no WebGL / reduced motion): the Paper construction, one rule
// set per state and scheme. Generated from the same palettes the shader uses.
function filmRules(layout: FilmLayout, scheme: Scheme = 'light') {
	return FILM_STATES.map((state) => {
		const p = palette(state, layout, 'drain', scheme);
		const root = state === 'idle' ? 'html:not([data-section])' : `html[data-section="${state}"]`;
		const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;
		// Vertical lengths against max(panel height, ref) when the palette has a ref.
		const vert = (n: number) => (p.ref ? `calc(${+n.toFixed(5)} * max(100%, ${p.ref}px))` : pct(n));
		const blobs = p.blobs.map((b, i) =>
			`${root} .film-fallback i:nth-child(${i + 1}){left:${pct(b.x)};top:${vert(b.y)};width:${pct(b.w)};height:${vert(b.h)};filter:blur(${b.blur}px);opacity:${b.opacity};background-color:${b.color}}`);
		const gradient = gradientCss(p);
		const size = p.ref ? `;background-size:100% max(100%, ${p.ref}px)` : ';background-size:auto';
		return [
			`${root} .film-fallback{background-image:${gradient.replace('in oklab ', '')};background-image:${gradient}${size}}`,
			...blobs,
		].join('\n');
	}).join('\n');
}

// Dark rules come last, so they win only under the dark media query.
const filmCss = [
	filmRules('desktop'),
	`@media (max-width: 767px){\n${filmRules('mobile')}\n}`,
	`@media (prefers-color-scheme: dark){\n.film-fallback{background-color:${palette('idle', 'desktop', 'drain', 'dark').stops[0].color}}\n${filmRules('desktop', 'dark')}\n}`,
	`@media (prefers-color-scheme: dark) and (max-width: 767px){\n${filmRules('mobile', 'dark')}\n}`,
].join('\n');
---

<!doctype html>
<html lang="en" data-state={section ? 'expanded' : 'idle'} data-section={section}>
	<head>
		<BaseHead title={title} description={description} image={image} articleDate={articleDate} />
		<ClientRouter />
		<style is:inline set:html={filmCss}></style>
	</head>
	<body>
		<script is:inline>
			// Cold load: hide the panel and rail items until shell.ts runs the
			// first reveal. Falls back to visible if it never does.
			document.body.setAttribute('data-boot', '');
			setTimeout(function () { document.body.removeAttribute('data-boot'); }, 3000);
		</script>
		<div class="shell" data-shell>
			<div class="rail">
				<div class="rail-top">
					<Wordmark data-reveal />
				</div>
				<div class="rail-space"></div>
				<div class="intro">
					<h1 class="headline">
						<span class="headline-line headline-serif" data-reveal><em>Yoo wasupp</em></span>
						<span class="headline-line" data-reveal><em>Yiyuan's here, welcome!</em></span>
						<span class="headline-line" data-reveal>i mainly build abstractions,</span>
						<span class="headline-line" data-reveal>or tear them down</span>

					</h1>
					<p class="sub" data-reveal>i'm a software engineer based in singapore, passionate about building high-performance, reliable tools, and anything that makes me more productive</p>
				</div>
				<div class="rail-space"></div>
				<nav class="nav" aria-label="Main">
					{SECTIONS.map((s) => (
						<a
							href={s.path}
							class="nav-link"
							data-nav-link
							data-section={s.id}
							aria-current={s.id === section ? (path === s.path ? 'page' : 'true') : undefined}
							data-reveal
						>
							<span class="nav-label">{s.title}</span>
						</a>
					))}
					<span class="droplet nav-droplet" aria-hidden="true"></span>
					<div class="esc-hint" data-esc-hint aria-hidden="true"><kbd>esc</kbd><span>to close</span></div>
				</nav>
				<ul class="links">
					{FOOTER_LINKS.map((l) => (
						<li data-reveal><a href={l.link} class="label-mono">{l.title}</a></li>
					))}
				</ul>
			</div>
			<div class="well">
				<div class="panel" data-panel>
					<div class="film" data-film-layer aria-hidden="true">
						<div class="film-fallback"><i></i><i></i><i></i><i></i></div>
						<canvas class="film-canvas" data-film-canvas></canvas>
						<div class="film-grain"></div>
					</div>
					<main class="panel-content" data-panel-content>
						<slot />
					</main>
					<div class="panel-edge" data-panel-edge aria-hidden="true"></div>
				</div>
			</div>
		</div>
		<script>
			import '../scripts/shell';
		</script>
	</body>
</html>
