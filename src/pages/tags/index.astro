---
import Shell from '@/layouts/Shell';
import PanelHeader from '@/components/PanelHeader';
import ListRow from '@/components/blog/ListRow';
import { getAllPosts, getUniqueTagsWithCount } from '@/utils';

const posts = await getAllPosts();
const tags = getUniqueTagsWithCount(posts);
---

<Shell title="Tags" description="All tags" section="writing">
	<PanelHeader title="Tags" />
	{tags.length > 0 && (
		<ul class="border-b border-hairline">
			{tags.map(([tag, count]) => (
				<ListRow href={`/tags/${tag}/`} title={`#${tag}`} meta={`${count} ${count === 1 ? 'post' : 'posts'}`} />
			))}
		</ul>
	)}
</Shell>
