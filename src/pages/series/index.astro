---
import Shell from '@/layouts/Shell';
import PanelHeader from '@/components/PanelHeader';
import ListRow from '@/components/blog/ListRow';
import { getAllPosts, getUniqueWithCountByProperty } from '@/utils';

const posts = await getAllPosts();
const series = getUniqueWithCountByProperty("series", posts);
---

<Shell title="Series" description="All series" section="writing">
	<PanelHeader title="Series" />
	{series.length > 0 && (
		<ul class="border-b border-hairline">
			{series.map(([s, count]) => (
				<ListRow href={`/series/${s}/`} title={s} meta={`${count} ${count === 1 ? 'post' : 'posts'}`} />
			))}
		</ul>
	)}
</Shell>
