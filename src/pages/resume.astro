---
import Shell from '@/layouts/Shell';
import PanelHeader from '@/components/PanelHeader';
import { RESUME_PDF, about, experience, education, skills } from '../data/resume';

const heading = 'text-[17px] font-medium leading-6 text-ink';
// Mobile: date stacked above the entry. Desktop: 188px date lane.
const entry = 'flex flex-col md:flex-row';
const period = 'nudge shrink-0 text-muted md:w-[188px]';
---

<Shell title="Resume" description="Resume of Yiyuan Li" section="resume">
	<PanelHeader title="Resume">
		<a
			slot="actions"
			href={RESUME_PDF}
			download
			class="flex items-center gap-2 rounded-full bg-ink px-[18px] py-[10px] text-[15px] font-medium leading-5 text-paper"
		>
			Download resume
			<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="shrink-0">
				<path d="M7 2v8M3.5 6.5L7 10l3.5-3.5M2.5 12h9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</PanelHeader>
	<div class="max-w-[840px] text-[16px] leading-[30px]">
		<section class="flex flex-col gap-5 pb-14 pt-6">
			<h2 class={heading}>About</h2>
			<p class="nudge max-w-[800px] text-ink-2">{about}</p>
		</section>
		<section class="flex flex-col gap-5 pb-14">
			<h2 class={heading}>Experience</h2>
			<div class="flex flex-col gap-7">
				{experience.map((e) => (
					<div class={entry}>
						<p class={period}>{e.period}</p>
						<div class="min-w-0 flex-1">
							<p class="nudge text-ink">{e.title}</p>
							<p class="nudge text-ink-2">{e.description}</p>
						</div>
					</div>
				))}
			</div>
		</section>
		<section class="flex flex-col gap-5 pb-14">
			<h2 class={heading}>Education</h2>
			<div class="flex flex-col gap-5">
				{education.map((e) => (
					<div class={entry}>
						<p class={period}>{e.period}</p>
						<p class="nudge min-w-0 flex-1 text-ink">{e.title}</p>
					</div>
				))}
			</div>
		</section>
		<section class="flex flex-col gap-5 pb-6">
			<h2 class={heading}>Skills</h2>
			<ul class="flex flex-wrap gap-[10px]">
				{skills.map((s) => (
					<li class="rounded-full bg-white/70 px-[14px] py-[6px] text-[15px] leading-[22px] text-ink">{s}</li>
				))}
			</ul>
		</section>
	</div>
</Shell>
