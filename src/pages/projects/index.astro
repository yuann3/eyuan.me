---
import Shell from '@/layouts/Shell';
import PanelHeader from '@/components/PanelHeader';
import { getAllProjects, sortProjectsByDate } from '@/utils';

// Paper's order; anything not listed follows, newest first.
const ORDER = ['emaclaude', 'mra', 'shaderview', 'linear-app', 'sequel', 'rego', 'rayrust', 'lrle', 'shell', 'ruskey', 'pew', 'hrust', 'ylib'];
const rank = (slug: string) => (ORDER.includes(slug) ? ORDER.indexOf(slug) : ORDER.length);
const projects = sortProjectsByDate(await getAllProjects()).sort((a, b) => rank(a.slug) - rank(b.slug));
---

<Shell title="Projects" description="Things I've built." section="projects">
	<PanelHeader title="Projects" />
	<ul class="rows">
		{projects.map(({ slug, data }) => (
			<li>
				<a href={`/projects/${slug}`} class="row project">
					<span class="flex min-w-0 flex-1 flex-col gap-0.5 md:flex-row md:items-center md:gap-0">
						<span class="project-name">{data.title.toLowerCase()}</span>
						<span class="project-summary hidden md:block">{data.summary ?? data.description}</span>
						<span class="project-summary md:hidden">{data.summaryShort ?? data.summary ?? data.description}</span>
					</span>
					<span class="label-mono hidden w-[200px] shrink-0 text-muted min-[1100px]:block">
						{data.stack.join(' · ')}
					</span>
					<span class="project-year">{data.pubDate.getFullYear()}</span>
				</a>
			</li>
		))}
	</ul>
</Shell>

<style>
	.project {
		align-items: flex-start;
		gap: 12px;
		padding: 14px 0 15px;
	}

	.project-name {
		color: var(--ink);
		font-size: 18px;
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 24px;
	}

	.project-summary {
		color: var(--ink-2);
		font-size: 14px;
		line-height: 20px;
	}

	.project-year {
		flex-shrink: 0;
		width: 40px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 12px;
		line-height: 24px;
		text-align: right;
	}

	@media (min-width: 768px) {
		.project {
			align-items: center;
			gap: 0;
			padding: 10px 0;
		}

		.project-name {
			flex-shrink: 0;
			width: 220px;
			font-size: 20px;
		}

		.project-summary {
			min-width: 0;
			font-size: 15px;
			line-height: 22px;
		}

		.project-year {
			width: 48px;
			font-size: 13px;
			line-height: 18px;
		}
	}
</style>
