---

<BaseLayout title="Cave">
	<section class="border border-black p-6 mb-8 overflow-hidden">
		<pre id="ascii-art" class="font-ascii text-xs sm:text-sm mb-4 leading-tight font-bold"></pre>
		<script define:vars={{ asciiArts }}>
			const randomIndex = Math.floor(Math.random() * asciiArts.length);
			document.getElementById('ascii-art').textContent = asciiArts[randomIndex];
		</script>
		<h1 class="font-display text-xl mb-4">Welcome to my cave</h1>
		<p class="mb-4">
			Hi there! I'm Yiyuan Li, a software engineer interested in Rust and low level programming.
		</p>
		<p class="mb-4">
			I share projects, tech topics, films, and life here.
		</p>
		<p class="mb-4">
		Im always open to work and new opportunities 
			<a href="/YiyuanLi_Resume.pdf" class="cody-link">[resume]</a>
		</p>
		<div class="flex items-center gap-2">
			<span class="text-muted">links:</span>
			<SocialMediaLinks/>
		</div>
	</section>

	<section class="mb-8 mt-12">
		<div class="flex justify-between items-center mb-4 border-b border-black pb-2">
			<h2 class="font-display text-lg">Projects</h2>
			<a href="/projects" class="text-sm hover:bg-black hover:text-bgColor px-1">[all]</a>
		</div>

		<div class="grid md:grid-cols-2 gap-8">
			<div>
				<h3 class="font-bold mb-2 border-b border-dotted border-black pb-1">Agents</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/emaclaude" class="cody-link">emaclaude</a>
							<span class="text-muted text-xs ml-2">3-agent coding system in Emacs</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/mra" class="cody-link">mra</a>
							<span class="text-muted text-xs ml-2">multi-agent runtime for Rust</span>
						</div>
					</li>
				</ul>

				<h3 class="font-bold mb-2 mt-6 border-b border-dotted border-black pb-1">Backend</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/sequel" class="cody-link">sequel</a>
							<span class="text-muted text-xs ml-2">SQLite engine in Rust</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/rego" class="cody-link">rego</a>
							<span class="text-muted text-xs ml-2">Redis server in Go</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/hrust" class="cody-link">hrust</a>
							<span class="text-muted text-xs ml-2">HTTP server in Rust</span>
						</div>
					</li>
				</ul>

				<h3 class="font-bold mb-2 mt-6 border-b border-dotted border-black pb-1">Languages</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/ruskey" class="cody-link">ruskey</a>
							<span class="text-muted text-xs ml-2">Monkey language interpreter</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/ylib" class="cody-link">ylib</a>
							<span class="text-muted text-xs ml-2">C stdlib rewrite</span>
						</div>
					</li>
				</ul>
			</div>

			<div>
				<h3 class="font-bold mb-2 border-b border-dotted border-black pb-1">Graphics</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/shaderview" class="cody-link">shaderview</a>
							<span class="text-muted text-xs ml-2">GLSL shader preview in Emacs</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/rayrust" class="cody-link">rayrust</a>
							<span class="text-muted text-xs ml-2">ray tracer with GPU acceleration</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/lrle" class="cody-link">lrle</a>
							<span class="text-muted text-xs ml-2">GPU terrain visualizer</span>
						</div>
					</li>
				</ul>

				<h3 class="font-bold mb-2 mt-6 border-b border-dotted border-black pb-1">Tools</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/linear-app" class="cody-link">linear-app.el</a>
							<span class="text-muted text-xs ml-2">Linear.app in Emacs</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/pew" class="cody-link">pew</a>
							<span class="text-muted text-xs ml-2">codebase dumper for LLMs</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/projects/shell" class="cody-link">shell</a>
							<span class="text-muted text-xs ml-2">minimal shell in Rust</span>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section>
		<div class="flex justify-between items-center mb-4 border-b border-black pb-2">
			<h2 class="font-display text-lg">Recent Posts</h2>
			<a href="/blog" class="text-sm hover:bg-black hover:text-bgColor px-1">[all]</a>
		</div>
		<ul class="space-y-2">
			{allPostsByPinned.map(p => <PostPreview post={p}/>)}
		</ul>
	</section>
</BaseLayout>
