---
import BaseLayout from '../layouts/Base.astro';
import PostPreview from "../components/blog/PostPreviewB.astro";
import SocialMediaLinks from "../components/SocialMediaLinks.astro";
import { getAllPosts, sortMDByDate, sortMDByPinned } from "../utils";

const MAX_POSTS = 5;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
const allPostsByPinned = sortMDByPinned(allPostsByDate);
---

<BaseLayout title="Cave">
	<section class="border border-black p-6 mb-8">
		<pre class="font-display text-xs sm:text-sm mb-4 leading-none font-bold">
__/\\\________/\\\__/\\\________/\\\___________/\\\________/\\\________/\\\________/\\\_______        
 _\///\\\____/\\\/__\///\\\____/\\\/_________/\\\//\\\_____\///\\\____/\\\/______/\\\\/\\\\____       
  ___\///\\\/\\\/______\///\\\/\\\/__________/\\\_/\\\________\///\\\/\\\/______/\\\//\////\\\__      
   _____\///\\\/__________\///\\\/___________\//\\\\//___________\///\\\/_______/\\\______\//\\\_     
    _______\/\\\_____________\/\\\___________/\\\///\\\_____________\/\\\_______\//\\\______/\\\__     
     _______\/\\\_____________\/\\\_________/\\\/__\///\\\/\\\_______\/\\\________\///\\\\/\\\\/___   
      _______\/\\\_____________\/\\\________/\\\______\//\\\//________\/\\\__________\////\\\//_____  
       _______\/\\\_____________\/\\\_______\//\\\\\\\\\\\//\\\________\/\\\_____________\///\\\\\\__ 
        _______\///______________\///_________\///////////_\///_________\///________________\//////___
		</pre>
		<h1 class="font-display text-xl mb-4">Welcome to my cave</h1>
		<p class="mb-4">
			Hi there! I'm Yiyuan Li, a software engineer interested in Rust and low level programming.
		</p>
		<p class="mb-4">
			I share projects, tech topics, films, and life here.
		</p>
		<p class="mb-4">
		Im always open to work and new opportunities 
			<a href="/YiyuanLi_CV.pdf" class="cody-link">[resume]</a>
		</p>
		<div class="flex items-center gap-2">
			<span class="text-muted">links:</span>
			<SocialMediaLinks/>
		</div>
	</section>

	<section class="mb-8 mt-12">
		<div class="flex justify-between items-center mb-4 border-b border-black pb-2">
			<h2 class="font-display text-lg">Projects</h2>
			<a href="/project" class="text-sm hover:bg-black hover:text-bgColor px-1">[all]</a>
		</div>

		<div class="grid md:grid-cols-2 gap-8">
			<div>
				<h3 class="font-bold mb-2 border-b border-dotted border-black pb-1">Backend</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/rego" class="cody-link">sequel</a>
							<span class="text-muted text-xs ml-2">SQLite engine in Rust</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/rego" class="cody-link">rego</a>
							<span class="text-muted text-xs ml-2">Redis server clone in Go</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/hrust" class="cody-link">hrust</a>
							<span class="text-muted text-xs ml-2">HTTP server in Rust</span>
						</div>
					</li>
				</ul>

				<h3 class="font-bold mb-2 mt-6 border-b border-dotted border-black pb-1">Languages</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/ruskey" class="cody-link">ruskey</a>
							<span class="text-muted text-xs ml-2">A language interpreter</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/ylib" class="cody-link">ylib</a>
							<span class="text-muted text-xs ml-2">C stdlib rewrite</span>
						</div>
					</li>
				</ul>
			</div>

			<div>
				<h3 class="font-bold mb-2 border-b border-dotted border-black pb-1">Graphics</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/rayrust" class="cody-link">rayrust</a>
							<span class="text-muted text-xs ml-2">ray tracer, cpu based</span>
						</div>
					</li>
				</ul>

				<h3 class="font-bold mb-2 mt-6 border-b border-dotted border-black pb-1">Tools</h3>
				<ul class="space-y-2">
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/pew" class="cody-link">pew</a>
							<span class="text-muted text-xs ml-2">codebase dumper for LLMs</span>
						</div>
					</li>
					<li class="flex gap-2">
						<span class="text-muted">></span>
						<div>
							<a href="/project/shell" class="cody-link">shell</a>
							<span class="text-muted text-xs ml-2">minimal shell in Rust, it just works</span>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section>
		<div class="flex justify-between items-center mb-4 border-b border-black pb-2">
			<h2 class="font-display text-lg">Recent Posts</h2>
			<a href="/blog" class="text-sm hover:bg-black hover:text-bgColor px-1">[all]</a>
		</div>
		<ul class="space-y-2">
			{allPostsByPinned.map(p => <PostPreview post={p}/>)}
		</ul>
	</section>
</BaseLayout>
